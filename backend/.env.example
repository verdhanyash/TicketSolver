# TicketSolver backend environment variables.
# Copy to `.env` and fill in. NEVER commit real secrets (see NFR: Security).

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (frontend dev server, etc.)
CORS_ORIGINS=http://localhost:5173

# --- NVIDIA NIM (LLM inference, OpenAI-compatible) ---
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL_STRONG=meta/llama-3.3-70b-instruct
NIM_MODEL_CHEAP=meta/llama-3.1-8b-instruct

# --- PostgreSQL (Supabase / Neon free tier; local dev uses docker-compose :5433) ---
DATABASE_URL=postgresql+psycopg://ticketsolver:ticketsolver@localhost:5433/ticketsolver

# --- Qdrant (vector DB, self-hosted) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks

# --- Ollama (local embeddings; dimension must match a live probe) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
